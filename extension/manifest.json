{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "VOID-RAY",
  "description": "__MSG_extDescription__",
  "version": "1.0.0",
  "default_locale": "fr",
  "minimum_chrome_version": "110",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "VOID-RAY",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": [
    "proxy",
    "storage",
    "alarms",
    "privacy",
    "webRequest",
    "webRequestAuthProvider"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
