<Window x:Class="VoidRay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:VoidRay.ViewModels"
        xmlns:svc="clr-namespace:VoidRay.Services"
        xmlns:ctl="clr-namespace:VoidRay.Controls"
        Title="VOID-RAY" Icon="Assets/voidray.ico"
        Width="1280" Height="820" MinWidth="1080" MinHeight="720"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource InkBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="60" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <!-- Colour of a figure depending on its tone -->
        <Style x:Key="ToneText" TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tone}" Value="Warn">
                    <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Alert">
                    <Setter Property="Foreground" Value="{DynamicResource AlertBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Status chip (ok = accent, warn, alert) -->
        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentTextBrush}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="TextElement.FontSize" Value="11" />
            <Setter Property="TextElement.FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tone}" Value="Warn">
                    <Setter Property="Background" Value="{DynamicResource WarnSoftBrush}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource WarnBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Alert">
                    <Setter Property="Background" Value="{DynamicResource AlertSoftBrush}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource AlertBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Status colour of the subscription (ok / warn / alert) -->
        <Style x:Key="StatusTint" TargetType="StackPanel">
            <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusTone}" Value="Warn">
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource WarnBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusTone}" Value="Alert">
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource AlertBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>

        <!-- Visible only on one inspector tab: Tag = tab name -->
        <Style x:Key="TabPage" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="overview" />
                        <Condition Binding="{Binding Tab}" Value="overview" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="servers" />
                        <Condition Binding="{Binding Tab}" Value="servers" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="plan" />
                        <Condition Binding="{Binding Tab}" Value="plan" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <!-- The brand mark -->
        <DataTemplate x:Key="LogoMark">
            <Viewbox>
                <Canvas Width="32" Height="32">
                    <Ellipse Canvas.Left="5" Canvas.Top="5" Width="22" Height="22"
                             Stroke="{DynamicResource BrandGradient}" StrokeThickness="3" />
                    <Ellipse Canvas.Left="12" Canvas.Top="12" Width="8" Height="8"
                             Fill="{DynamicResource BrandGradient}" />
                    <Line X1="1" Y1="31" X2="31" Y2="1" Stroke="{DynamicResource AccentBrush}"
                          StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Canvas>
            </Viewbox>
        </DataTemplate>

        <Storyboard x:Key="AuroraDrift">
            <DoubleAnimation Storyboard.TargetName="AuroraA" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                             From="-60" To="140" Duration="0:0:19" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="AuroraA" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                             From="-40" To="80" Duration="0:0:23" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="AuroraB" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                             From="80" To="-120" Duration="0:0:21" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="AuroraB" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                             From="60" To="-70" Duration="0:0:17" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="AuroraC" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                             From="-90" To="90" Duration="0:0:27" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard Storyboard="{StaticResource AuroraDrift}" />
        </EventTrigger>
    </Window.Triggers>

    <Grid x:Name="Root" ClipToBounds="True">
        <!-- ============================================================ aurora -->
        <Grid IsHitTestVisible="False" Opacity="{DynamicResource AuroraOpacity}">
            <Ellipse x:Name="AuroraA" Width="1100" Height="1100" Margin="-420,-520,0,0"
                     HorizontalAlignment="Left" VerticalAlignment="Top" Fill="{DynamicResource AuroraABrush}">
                <Ellipse.RenderTransform><TranslateTransform /></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="AuroraB" Width="1000" Height="1000" Margin="0,0,-380,-460"
                     HorizontalAlignment="Right" VerticalAlignment="Bottom" Fill="{DynamicResource AuroraBBrush}">
                <Ellipse.RenderTransform><TranslateTransform /></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="AuroraC" Width="760" Height="760" Margin="-160,0,0,-520"
                     HorizontalAlignment="Left" VerticalAlignment="Bottom" Fill="{DynamicResource AuroraCBrush}" Opacity="0.55">
                <Ellipse.RenderTransform><TranslateTransform /></Ellipse.RenderTransform>
            </Ellipse>
        </Grid>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="60" />
                <RowDefinition Height="*" />
                <RowDefinition Height="44" />
            </Grid.RowDefinitions>

            <!-- ============================================================ title bar -->
            <DockPanel Grid.Row="0" Margin="24,0,12,0" LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource BtnAccent}" MinHeight="32" Padding="14,0" Margin="0,0,10,0"
                            WindowChrome.IsHitTestVisibleInChrome="True" Command="{Binding CheckUpdatesCommand}"
                            Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <ctl:Icon Data="{StaticResource IcoDown}" Size="14" StrokeThickness="2.2" Margin="0,0,7,0" />
                            <TextBlock Text="{Binding UpdateLabel}" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource WinBtn}" Click="Minimize_Click"
                            ToolTip="{Binding [minimize], Source={x:Static svc:Loc.I}}">
                        <ctl:Icon Data="{StaticResource IcoMin}" Size="14" />
                    </Button>
                    <Button Style="{StaticResource WinBtn}" Click="Maximize_Click"
                            ToolTip="{Binding [maximize], Source={x:Static svc:Loc.I}}">
                        <ctl:Icon x:Name="MaximizeIcon" Data="{StaticResource IcoMax}" Size="13" />
                    </Button>
                    <Button Style="{StaticResource WinCloseBtn}" Click="Close_Click"
                            ToolTip="{Binding [closeToTray], Source={x:Static svc:Loc.I}}">
                        <ctl:Icon Data="{StaticResource IcoClose}" Size="14" />
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ContentControl ContentTemplate="{StaticResource LogoMark}" Width="30" Height="30" Focusable="False" />
                    <TextBlock Text="VOID-RAY" FontFamily="{StaticResource DisplayFont}" FontSize="21" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="12,0,0,1" />
                    <Border CornerRadius="10" Background="{DynamicResource SurfaceBrush}" Padding="10,4" Margin="14,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{DynamicResource MutedBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding IdentityTitle}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAuthenticated}" Value="False">
                                            <Setter Property="Text" Value="by EnderrVPN" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </StackPanel>
            </DockPanel>

            <!-- ============================================================ GATE -->
            <Grid Grid.Row="1" Margin="40,0,40,0"
                  Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="500" />
                </Grid.ColumnDefinitions>

                <Viewbox MaxWidth="680" MaxHeight="680" Margin="0,-30,0,0">
                    <ContentControl Template="{StaticResource OrbTemplate}" Tag="Disconnected" Focusable="False" Margin="120" />
                </Viewbox>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,20,40">
                    <TextBlock Text="{Binding [gateHeadline], Source={x:Static svc:Loc.I}}" FontFamily="{StaticResource DisplayFont}"
                               FontSize="46" FontWeight="SemiLight" TextWrapping="Wrap" LineHeight="52" />
                    <TextBlock Text="{Binding [gateText], Source={x:Static svc:Loc.I}}" FontSize="14"
                               Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" LineHeight="21" Margin="0,14,0,26" />

                    <Grid>
                        <TextBox x:Name="GateInput" Style="{StaticResource Input}" Padding="16,0,56,0"
                                 Text="{Binding GateUrl, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="{x:Static svc:Brand.LinkExample}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SignInCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Style="{StaticResource IconBtn}" HorizontalAlignment="Right" Margin="0,0,8,0"
                                Click="Paste_Click" ToolTip="Paste">
                            <ctl:Icon Data="{StaticResource IcoPaste}" Size="17" />
                        </Button>
                    </Grid>

                    <TextBlock Text="{Binding GateError}" Foreground="{DynamicResource AlertBrush}" FontSize="13"
                               TextWrapping="Wrap" Margin="6,10,0,0"
                               Visibility="{Binding GateError, Converter={StaticResource NotEmptyToVis}}" />

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource BtnSolid}" MinHeight="64" Command="{Binding SignInCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding GateButtonText}" VerticalAlignment="Center" />
                                <ctl:Icon Data="{StaticResource IcoArrowRight}" Size="18" StrokeThickness="2.1" Margin="10,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1" Style="{StaticResource RoundSolid}" Margin="14,0,0,0"
                                Command="{Binding ToggleSettingsCommand}" ToolTip="{Binding [settings], Source={x:Static svc:Loc.I}}">
                            <ctl:Icon Data="{StaticResource IcoGear}" Size="24" />
                        </Button>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="6,22,0,0">
                        <TextBlock Text="{Binding [gateHelp], Source={x:Static svc:Loc.I}}" FontSize="13"
                                   Foreground="{DynamicResource MutedBrush}" Margin="0,0,6,0" />
                        <Button Style="{StaticResource LinkBtn}" Command="{Binding OpenSupportCommand}">
                            <TextBlock Text="{Binding [gateContact], Source={x:Static svc:Loc.I}}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource InkBrush}" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- ============================================================ HOME -->
            <Grid Grid.Row="1" Margin="24,0,20,0"
                  Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="430" />
                </Grid.ColumnDefinitions>

                <!-- ======================================== hero -->
                <Grid Margin="16,0,36,8" MaxWidth="620" HorizontalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Viewbox MaxWidth="600" MaxHeight="600" Margin="0,-40,0,-10">
                        <ContentControl Template="{StaticResource OrbTemplate}" Tag="{Binding State}" Focusable="False" Margin="120" />
                    </Viewbox>

                    <!-- server chip → servers tab -->
                    <Button Grid.Row="1" HorizontalAlignment="Left" Command="{Binding SetTabCommand}" CommandParameter="servers"
                            Cursor="Hand" FocusVisualStyle="{x:Null}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" CornerRadius="16" BorderThickness="1.5" BorderBrush="{DynamicResource InkBrush}"
                                        Background="Transparent" Padding="10,9,16,9">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="36" Height="28" CornerRadius="8" Background="{DynamicResource SolidBrush}">
                                <ctl:Icon Data="{StaticResource IcoGlobe}" Size="17" Foreground="{DynamicResource OnSolidBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{Binding SelectedServerName}" FontSize="15" FontWeight="Medium" Margin="12,0,0,0"
                                       VerticalAlignment="Center" MaxWidth="320" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding SelectedServer.PingText}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                       Foreground="{DynamicResource MutedBrush}" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <TextBlock Grid.Row="2" Text="{Binding HeroTitle}" FontFamily="{StaticResource DisplayFont}" FontSize="58"
                               FontWeight="SemiLight" Margin="0,20,0,0" TextTrimming="CharacterEllipsis" />

                    <!-- live line -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="2,8,0,0" Height="22">
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,9,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource MutedBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding StateText}" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="13" Foreground="{DynamicResource MutedBrush}"
                                   VerticalAlignment="Center" Margin="12,0,0,0"
                                   Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}">
                            <Run Text="{Binding Elapsed, Mode=OneWay}" />
                            <Run Text="  ·  " />
                            <Run Text="{Binding PublicIp, Mode=OneWay}" />
                            <Run Text="  ·  " />
                            <Run Text="{Binding ExitCountry, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Text="{Binding ModeHint}" FontSize="13" Foreground="{DynamicResource MutedBrush}"
                                   VerticalAlignment="Center" Margin="12,0,0,0"
                                   Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                    </StackPanel>

                    <Grid Grid.Row="4" Margin="0,28,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ctl:SlideToConnect Label="{Binding SlideLabel}" IsOn="{Binding IsOnSide, Mode=OneWay}"
                                            IsBusy="{Binding IsBusy, Mode=OneWay}" Command="{Binding ToggleConnectionCommand}" />
                        <Button Grid.Column="1" Style="{StaticResource RoundSolid}" Margin="16,0,0,0"
                                Command="{Binding ToggleSettingsCommand}" ToolTip="{Binding [settings], Source={x:Static svc:Loc.I}}">
                            <ctl:Icon Data="{StaticResource IcoGear}" Size="24" />
                        </Button>
                    </Grid>
                </Grid>

                <!-- ======================================== inspector -->
                <Border Grid.Column="1" Style="{StaticResource Glass}" Margin="0,4,0,8" Padding="20,18,20,20">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="60" ShadowDepth="18" Direction="270" Opacity="0.22" />
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- tabs -->
                        <Border Style="{StaticResource SegTrack}" Margin="0,0,0,18">
                            <UniformGrid Rows="1">
                                <Button Style="{StaticResource SegBtn}" Command="{Binding SetTabCommand}" CommandParameter="overview"
                                        Tag="{Binding Tab, Converter={StaticResource Eq}, ConverterParameter=overview}">
                                    <TextBlock Text="{Binding [tabOverview], Source={x:Static svc:Loc.I}}" />
                                </Button>
                                <Button Style="{StaticResource SegBtn}" Command="{Binding SetTabCommand}" CommandParameter="servers"
                                        Tag="{Binding Tab, Converter={StaticResource Eq}, ConverterParameter=servers}">
                                    <TextBlock Text="{Binding [tabServers], Source={x:Static svc:Loc.I}}" />
                                </Button>
                                <Button Style="{StaticResource SegBtn}" Command="{Binding SetTabCommand}" CommandParameter="plan"
                                        Tag="{Binding Tab, Converter={StaticResource Eq}, ConverterParameter=plan}">
                                    <TextBlock Text="{Binding [tabPlan], Source={x:Static svc:Loc.I}}" />
                                </Button>
                            </UniformGrid>
                        </Border>

                        <!-- overview -->
                        <ScrollViewer Grid.Row="1" Tag="overview" Style="{StaticResource TabPage}" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="{Binding [connection], Source={x:Static svc:Loc.I}}" Style="{StaticResource Caption}" />
                                <UniformGrid Columns="2">
                                    <Border Style="{StaticResource Tile}" Margin="0,0,5,10">
                                        <StackPanel>
                                            <TextBlock Text="{Binding [duration], Source={x:Static svc:Loc.I}}" Style="{StaticResource StatLabel}" />
                                            <TextBlock Text="{Binding Elapsed}" Style="{StaticResource StatValue}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Tile}" Margin="5,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="{Binding [realDelay], Source={x:Static svc:Loc.I}}" Style="{StaticResource StatLabel}" />
                                            <TextBlock Text="{Binding RealDelay}" Style="{StaticResource StatValue}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Tile}" Margin="0,0,5,0">
                                        <StackPanel>
                                            <TextBlock Text="{Binding [publicIp], Source={x:Static svc:Loc.I}}" Style="{StaticResource StatLabel}" />
                                            <TextBlock Text="{Binding PublicIp}" Style="{StaticResource StatValue}" FontSize="15" ToolTip="{Binding PublicIp}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Tile}" Margin="5,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="{Binding [location], Source={x:Static svc:Loc.I}}" Style="{StaticResource StatLabel}" />
                                            <TextBlock Text="{Binding ExitCountry}" Style="{StaticResource StatValue}" FontSize="15" ToolTip="{Binding ExitCountry}" />
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <TextBlock Text="{Binding [mode], Source={x:Static svc:Loc.I}}" Style="{StaticResource Caption}" Margin="4,22,0,8" />
                                <Border Style="{StaticResource SegTrack}">
                                    <UniformGrid Rows="1">
                                        <Button Style="{StaticResource SegBtn}" Command="{Binding SetModeCommand}" CommandParameter="tun"
                                                Tag="{Binding IsTunMode}">
                                            <TextBlock Text="{Binding [modeTun], Source={x:Static svc:Loc.I}}" />
                                        </Button>
                                        <Button Style="{StaticResource SegBtn}" Command="{Binding SetModeCommand}" CommandParameter="proxy"
                                                Tag="{Binding IsProxyMode}">
                                            <TextBlock Text="{Binding [modeProxy], Source={x:Static svc:Loc.I}}" />
                                        </Button>
                                    </UniformGrid>
                                </Border>
                                <TextBlock Text="{Binding ModeHint}" FontSize="12.5" Foreground="{DynamicResource MutedBrush}"
                                           TextWrapping="Wrap" Margin="6,8,0,0" />

                                <TextBlock Text="{Binding [tabPlan], Source={x:Static svc:Loc.I}}" Style="{StaticResource Caption}" Margin="4,22,0,8" />
                                <Button Style="{StaticResource Bare}" Background="Transparent" Command="{Binding SetTabCommand}" CommandParameter="plan">
                                    <Border Style="{StaticResource Tile}" Padding="18,16">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding GaugeValue}" FontFamily="{StaticResource MonoFont}" FontSize="30"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding GaugeUnit}" FontFamily="{StaticResource MonoFont}" FontSize="15"
                                                               Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Bottom" Margin="6,0,0,5" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding GaugeCaption}" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Style="{StaticResource StatusTint}">
                                                <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,7,0"
                                                         Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" />
                                                <TextBlock Text="{Binding StatusLabel}" FontSize="12.5" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Button>
                                <ctl:UsageBars Height="54" Margin="4,14,4,0" Values="{Binding History}"
                                               Bar="{DynamicResource BarBrush}" Void="{DynamicResource LineBrush}"
                                               Visibility="{Binding HasHistory, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </ScrollViewer>

                        <!-- servers -->
                        <Grid Grid.Row="1" Tag="servers" Style="{StaticResource TabPage}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <DockPanel Margin="4,0,0,12">
                                <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" MinHeight="34" Padding="14,0"
                                        Command="{Binding PingAllCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <ctl:Icon Data="{StaticResource IcoBolt}" Size="13" Margin="0,0,7,0" />
                                        <TextBlock Text="{Binding [testPing], Source={x:Static svc:Loc.I}}" FontSize="12.5" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <TextBlock VerticalAlignment="Center" Style="{StaticResource SectionLabel}">
                                    <Run Text="{Binding ServerCount, Mode=OneWay}" />
                                    <Run Text="{Binding [configs], Source={x:Static svc:Loc.I}, Mode=OneWay}" />
                                </TextBlock>
                            </DockPanel>
                            <TextBlock Grid.Row="1" Text="{Binding [noConfigs], Source={x:Static svc:Loc.I}}" Foreground="{DynamicResource MutedBrush}"
                                       HorizontalAlignment="Center" Margin="0,30,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ServerCount}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ListBox Grid.Row="1" Style="{StaticResource CfgList}" ItemContainerStyle="{StaticResource CfgItem}"
                                     ItemsSource="{Binding Servers}" SelectedItem="{Binding SelectedServer}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ServerItemViewModel}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding FullName}" />
                                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                    <Border Style="{StaticResource TagProto}">
                                                        <TextBlock Text="{Binding ProtocolTag}" />
                                                    </Border>
                                                    <Border Style="{StaticResource Tag}">
                                                        <TextBlock Text="{Binding NetworkTag}" />
                                                    </Border>
                                                    <Border Style="{StaticResource TagSec}"
                                                            Visibility="{Binding HasSecurityTag, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="{Binding SecurityTag}" />
                                                    </Border>
                                                    <Border Style="{StaticResource TagWarn}"
                                                            ToolTip="{Binding [bypassTip], Source={x:Static svc:Loc.I}}"
                                                            Visibility="{Binding IsBypass, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="BYPASS" />
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding PingText}" FontFamily="{StaticResource MonoFont}"
                                                       FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Quality}" Value="Good">
                                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Quality}" Value="Medium">
                                                                <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Quality}" Value="Bad">
                                                                <Setter Property="Foreground" Value="{DynamicResource AlertBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Quality}" Value="Timeout">
                                                                <Setter Property="Foreground" Value="{DynamicResource AlertBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Button Grid.Column="2" Style="{StaticResource IconBtn}" Width="34" Height="34" MinHeight="34"
                                                    Background="Transparent"
                                                    Command="{Binding DataContext.CopyConfigCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="{Binding [copy], Source={x:Static svc:Loc.I}}">
                                                <ctl:Icon Data="{StaticResource IcoCopy}" Size="15" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>

                        <!-- subscription -->
                        <ScrollViewer Grid.Row="1" Tag="plan" Style="{StaticResource TabPage}" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Border Style="{StaticResource Tile}" Padding="16,16,16,18">
                                    <StackPanel>
                                        <Grid Width="250" Height="178" HorizontalAlignment="Center">
                                            <ctl:TickGauge Ratio="{Binding GaugeRatio}" Unlimited="{Binding IsUnlimited}"
                                                           Live="{Binding IsLive}" Idle="{DynamicResource MutedBrush}"
                                                           Width="250" Height="190" VerticalAlignment="Top">
                                                <ctl:TickGauge.Style>
                                                    <Style TargetType="ctl:TickGauge">
                                                        <Setter Property="Tone" Value="{DynamicResource AccentBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding GaugeTone}" Value="Warn">
                                                                <Setter Property="Tone" Value="{DynamicResource WarnBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding GaugeTone}" Value="Alert">
                                                                <Setter Property="Tone" Value="{DynamicResource AlertBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ctl:TickGauge.Style>
                                            </ctl:TickGauge>
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,90,0,0">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <TextBlock Text="{Binding GaugeValue}" FontFamily="{StaticResource MonoFont}"
                                                               FontSize="32" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding GaugeUnit}" FontFamily="{StaticResource MonoFont}"
                                                               FontSize="16" Foreground="{DynamicResource MutedBrush}"
                                                               VerticalAlignment="Bottom" Margin="5,0,0,5" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding GaugeCaption}" FontSize="11.5" HorizontalAlignment="Center"
                                                           Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Grid>
                                        <Border HorizontalAlignment="Center" CornerRadius="12" Padding="11,5,14,5"
                                                Background="{DynamicResource SurfaceBrush}">
                                            <StackPanel Orientation="Horizontal" Style="{StaticResource StatusTint}">
                                                <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,8,0"
                                                         Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" />
                                                <TextBlock Text="{Binding StatusLabel}" FontSize="12.5" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Border>
                                        <UniformGrid Columns="2" Margin="0,16,0,0">
                                            <StackPanel Margin="6,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <ctl:Icon Data="{StaticResource IcoUp}" Size="13" StrokeThickness="2.2"
                                                              Foreground="{DynamicResource Accent2Brush}" Margin="0,0,6,0" />
                                                    <TextBlock Text="{Binding [upload], Source={x:Static svc:Loc.I}}" Style="{StaticResource StatLabel}" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding UploadText}" Style="{StaticResource StatValue}" />
                                            </StackPanel>
                                            <StackPanel Margin="6,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <ctl:Icon Data="{StaticResource IcoDown}" Size="13" StrokeThickness="2.2"
                                                              Foreground="{DynamicResource AccentBrush}" Margin="0,0,6,0" />
                                                    <TextBlock Text="{Binding [download], Source={x:Static svc:Loc.I}}" Style="{StaticResource StatLabel}" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding DownloadText}" Style="{StaticResource StatValue}" />
                                            </StackPanel>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>

                                <DockPanel Margin="4,20,4,8">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding HistoryAverage}" FontFamily="{StaticResource MonoFont}"
                                               FontSize="11.5" Foreground="{DynamicResource Ink2Brush}" />
                                    <TextBlock Text="{Binding [history], Source={x:Static svc:Loc.I}}" Style="{StaticResource SectionLabel}" />
                                </DockPanel>
                                <ctl:UsageBars Height="56" Margin="4,0" Values="{Binding History}"
                                               Bar="{DynamicResource BarBrush}" Void="{DynamicResource LineBrush}"
                                               Visibility="{Binding HasHistory, Converter={StaticResource BoolToVis}}" />
                                <TextBlock Text="{Binding [histWait], Source={x:Static svc:Loc.I}}" FontSize="12" Margin="4,0"
                                           Foreground="{DynamicResource MutedBrush}"
                                           Visibility="{Binding HasHistory, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />

                                <TextBlock Text="{Binding [details], Source={x:Static svc:Loc.I}}" Style="{StaticResource Caption}" Margin="4,22,0,8" />
                                <Border Style="{StaticResource Tile}" Padding="0,4">
                                    <ItemsControl ItemsSource="{Binding DetailRows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="16,9">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Key}" FontSize="13" Foreground="{DynamicResource MutedBrush}"
                                                               VerticalAlignment="Center" Margin="0,0,14,0" />
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                                        <TextBlock x:Name="Val" Text="{Binding Value}" FontSize="13" FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis" Style="{StaticResource ToneText}"
                                                                   ToolTip="{Binding Value}" />
                                                        <TextBlock Text="{Binding Hint, StringFormat=' · {0}'}" FontSize="13"
                                                                   Foreground="{DynamicResource MutedBrush}"
                                                                   Visibility="{Binding HasHint, Converter={StaticResource BoolToVis}}" />
                                                        <Border Style="{StaticResource Chip}"
                                                                Visibility="{Binding IsChip, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="{Binding Value}" />
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Mono}" Value="True">
                                                        <Setter TargetName="Val" Property="FontFamily" Value="{StaticResource MonoFont}" />
                                                        <Setter TargetName="Val" Property="FontWeight" Value="Normal" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsChip}" Value="True">
                                                        <Setter TargetName="Val" Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                                <Button Style="{StaticResource Btn}" Margin="0,12,0,4" HorizontalAlignment="Stretch" Command="{Binding CopyIdCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <ctl:Icon Data="{StaticResource IcoCopy}" Size="14" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding [copyId], Source={x:Static svc:Loc.I}}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- ============================================================ footer -->
            <DockPanel Grid.Row="2" Margin="30,0,30,0" VerticalAlignment="Center"
                       TextElement.FontSize="11.5" TextElement.Foreground="{DynamicResource MutedBrush}">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Text="{Binding CurrentVersion}" FontFamily="{StaticResource MonoFont}" Margin="0,0,10,0" />
                    <Button Style="{StaticResource LinkBtn}" Command="{Binding CheckUpdatesCommand}" Margin="0,0,16,0">
                        <TextBlock Text="{Binding UpdateLabel}" />
                    </Button>
                    <Button Style="{StaticResource LinkBtn}" Command="{Binding OpenSupportCommand}">
                        <TextBlock Text="{Binding [support], Source={x:Static svc:Loc.I}}" />
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolToVis}}">
                    <Ellipse Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource MutedBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRefreshing}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding FreshText}" FontFamily="{StaticResource MonoFont}" />
                    <TextBlock Text="  ·  " />
                    <TextBlock Text="{Binding AccountsText}" TextTrimming="CharacterEllipsis" MaxWidth="480" />
                </StackPanel>
            </DockPanel>
        </Grid>

        <!-- ============================================================ toast -->
        <Border VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,70,0,0" CornerRadius="22"
                Background="{DynamicResource SolidBrush}" Padding="18,11" MaxWidth="560"
                Visibility="{Binding Toast, Converter={StaticResource NotEmptyToVis}}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="8" Direction="270" Opacity="0.3" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ToastIsError}" Value="True">
                                    <Setter Property="Fill" Value="{DynamicResource AlertBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding Toast}" FontSize="13" FontWeight="Medium" TextWrapping="Wrap"
                           Foreground="{DynamicResource OnSolidBrush}" />
            </StackPanel>
        </Border>

        <!-- ============================================================ settings drawer -->
        <Grid>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Setter Property="Opacity" Value="0" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSettingsOpen}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.24" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Button Style="{StaticResource Bare}" Background="{DynamicResource ScrimBrush}" Cursor="Arrow"
                    Command="{Binding ToggleSettingsCommand}" />

            <Border Width="420" HorizontalAlignment="Right" Margin="12" CornerRadius="28"
                    Background="{DynamicResource DrawerBrush}" BorderBrush="{DynamicResource GlassLineBrush}" BorderThickness="1">
                <Border.RenderTransform>
                    <TranslateTransform X="460" />
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="60" ShadowDepth="0" Opacity="0.35" />
                </Border.Effect>
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSettingsOpen}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                             To="0" Duration="0:0:0.38">
                                                <DoubleAnimation.EasingFunction><QuinticEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                             To="460" Duration="0:0:0.24">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn" /></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="26,22,18,8">
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconBtn}" Command="{Binding ToggleSettingsCommand}">
                            <ctl:Icon Data="{StaticResource IcoClose}" Size="16" />
                        </Button>
                        <TextBlock Text="{Binding [settings], Source={x:Static svc:Loc.I}}" FontFamily="{StaticResource DisplayFont}"
                                   FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="22,8,22,24">
                            <TextBlock Text="{Binding [theme], Source={x:Static svc:Loc.I}}" Style="{StaticResource Caption}" Margin="4,12,0,8" />
                            <Border Style="{StaticResource SegTrack}">
                                <UniformGrid Rows="1">
                                    <Button Style="{StaticResource SegBtn}" Command="{Binding SetThemeCommand}" CommandParameter="auto"
                                            Tag="{Binding ThemeMode, Converter={StaticResource Eq}, ConverterParameter=auto}">
                                        <TextBlock Text="{Binding [auto], Source={x:Static svc:Loc.I}}" />
                                    </Button>
                                    <Button Style="{StaticResource SegBtn}" Command="{Binding SetThemeCommand}" CommandParameter="dark"
                                            Tag="{Binding ThemeMode, Converter={StaticResource Eq}, ConverterParameter=dark}">
                                        <TextBlock Text="{Binding [dark], Source={x:Static svc:Loc.I}}" />
                                    </Button>
                                    <Button Style="{StaticResource SegBtn}" Command="{Binding SetThemeCommand}" CommandParameter="light"
                                            Tag="{Binding ThemeMode, Converter={StaticResource Eq}, ConverterParameter=light}">
                                        <TextBlock Text="{Binding [light], Source={x:Static svc:Loc.I}}" />
                                    </Button>
                                </UniformGrid>
                            </Border>

                            <TextBlock Text="{Binding [accentLabel], Source={x:Static svc:Loc.I}}" Style="{StaticResource Caption}" Margin="4,22,0,10" />
                            <ItemsControl ItemsSource="{Binding Accents}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:AccentOption}">
                                        <Button Command="{Binding DataContext.SetAccentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" ToolTip="{Binding Name}" Cursor="Hand" FocusVisualStyle="{x:Null}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Grid Width="48" Height="48" Background="Transparent">
                                                        <Ellipse x:Name="Ring" StrokeThickness="2" Stroke="Transparent" />
                                                        <Ellipse Margin="6" Fill="{Binding Swatch}" />
                                                        <ctl:Icon x:Name="Tick" Data="{StaticResource IcoCheck}" Size="18" StrokeThickness="2.4"
                                                                  Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                  Visibility="Collapsed" />
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource MutedBrush}" />
                                                        </Trigger>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource InkBrush}" />
                                                            <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="{Binding [langLabel], Source={x:Static svc:Loc.I}}" Style="{StaticResource Caption}" Margin="4,22,0,8" />
                            <Border Style="{StaticResource SegTrack}">
                                <UniformGrid Rows="1">
                                    <Button Style="{StaticResource SegBtn}" Command="{Binding SetLangCommand}" CommandParameter="auto"
                                            Tag="{Binding LangMode, Converter={StaticResource Eq}, ConverterParameter=auto}">
                                        <TextBlock Text="{Binding [auto], Source={x:Static svc:Loc.I}}" />
                                    </Button>
                                    <Button Style="{StaticResource SegBtn}" Command="{Binding SetLangCommand}" CommandParameter="en"
                                            Tag="{Binding LangMode, Converter={StaticResource Eq}, ConverterParameter=en}">
                                        <TextBlock Text="English" />
                                    </Button>
                                    <Button Style="{StaticResource SegBtn}" Command="{Binding SetLangCommand}" CommandParameter="fr"
                                            Tag="{Binding LangMode, Converter={StaticResource Eq}, ConverterParameter=fr}">
                                        <TextBlock Text="Français" />
                                    </Button>
                                </UniformGrid>
                            </Border>

                            <StackPanel Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding [link], Source={x:Static svc:Loc.I}}" Style="{StaticResource Caption}" Margin="4,22,0,8" />
                                <Border Style="{StaticResource Tile}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding SubscriptionUrl}" FontFamily="{StaticResource MonoFont}" FontSize="12.5"
                                                   Foreground="{DynamicResource Ink2Brush}" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding SubscriptionUrl}" />
                                        <UniformGrid Columns="3" Margin="0,12,0,0">
                                            <Button Style="{StaticResource Btn}" Background="{DynamicResource DrawerBrush}" Margin="0,0,4,0"
                                                    Command="{Binding CopyLinkCommand}">
                                                <StackPanel Orientation="Horizontal">
                                                    <ctl:Icon Data="{StaticResource IcoCopy}" Size="14" Margin="0,0,6,0" />
                                                    <TextBlock Text="{Binding [copy], Source={x:Static svc:Loc.I}}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource Btn}" Background="{DynamicResource DrawerBrush}" Margin="4,0"
                                                    Command="{Binding RefreshCommand}">
                                                <StackPanel Orientation="Horizontal">
                                                    <ctl:Icon Data="{StaticResource IcoRefresh}" Size="14" Margin="0,0,6,0" />
                                                    <TextBlock Text="{Binding [refresh], Source={x:Static svc:Loc.I}}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource Btn}" Background="{DynamicResource DrawerBrush}" Margin="4,0,0,0"
                                                    Command="{Binding ChangeLinkCommand}" ToolTip="{Binding [changeLink], Source={x:Static svc:Loc.I}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <ctl:Icon Data="{StaticResource IcoExit}" Size="14" Margin="0,0,6,0" />
                                                    <TextBlock Text="{Binding [changeLink], Source={x:Static svc:Loc.I}}" VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Button>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <TextBlock Text="{Binding [about], Source={x:Static svc:Loc.I}}" Style="{StaticResource Caption}" Margin="4,22,0,8" />
                            <Border Style="{StaticResource Tile}" Padding="0">
                                <StackPanel>
                                    <Button Style="{StaticResource Bare}" Background="Transparent" Command="{Binding CheckUpdatesCommand}">
                                        <DockPanel Margin="16,14">
                                            <ctl:Icon DockPanel.Dock="Right" Data="{StaticResource IcoChevron}" Size="15"
                                                      Foreground="{DynamicResource MutedBrush}" Margin="8,0,0,0" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding UpdateLabel}" FontSize="12.5" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasUpdate}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding CurrentVersion}" FontSize="14" FontWeight="Medium" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Button>
                                    <Rectangle Height="1" Fill="{DynamicResource LineBrush}" Margin="16,0" />
                                    <Button Style="{StaticResource Bare}" Background="Transparent" Command="{Binding OpenSupportCommand}">
                                        <DockPanel Margin="16,14">
                                            <ctl:Icon DockPanel.Dock="Right" Data="{StaticResource IcoChevron}" Size="15"
                                                      Foreground="{DynamicResource MutedBrush}" />
                                            <TextBlock Text="{Binding [support], Source={x:Static svc:Loc.I}}" FontSize="14" FontWeight="Medium" />
                                        </DockPanel>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <DockPanel Margin="4,22,0,8">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Style="{StaticResource Btn}" MinHeight="30" Padding="12,0" Margin="0,0,6,0" Command="{Binding CopyLogsCommand}">
                                        <TextBlock Text="{Binding [copy], Source={x:Static svc:Loc.I}}" FontSize="11.5" />
                                    </Button>
                                    <Button Style="{StaticResource Btn}" MinHeight="30" Padding="12,0" Command="{Binding ClearLogsCommand}">
                                        <TextBlock Text="{Binding [clear], Source={x:Static svc:Loc.I}}" FontSize="11.5" />
                                    </Button>
                                </StackPanel>
                                <TextBlock Text="{Binding [log], Source={x:Static svc:Loc.I}}" Style="{StaticResource Caption}" Margin="0"
                                           VerticalAlignment="Center" />
                            </DockPanel>
                            <Border Style="{StaticResource Tile}" Padding="12,10" Height="210">
                                <ListBox x:Name="LogList" ItemsSource="{Binding Logs}" Background="Transparent" BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" FocusVisualStyle="{x:Null}">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <ContentPresenter Margin="0,1" />
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                                       Foreground="{DynamicResource Ink2Brush}" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
