<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:conv="clr-namespace:VoidRay.Converters"
                    xmlns:ctl="clr-namespace:VoidRay.Controls">

    <!-- Brushes are (re)defined at runtime by ThemeManager; these are only design-time defaults. -->
    <SolidColorBrush x:Key="BgBrush" Color="#07090e" />
    <SolidColorBrush x:Key="InkBrush" Color="#e8ecf4" />
    <SolidColorBrush x:Key="Ink2Brush" Color="#aab3c6" />
    <SolidColorBrush x:Key="MutedBrush" Color="#737e96" />
    <SolidColorBrush x:Key="AccentBrush" Color="#52d6bd" />
    <SolidColorBrush x:Key="Accent2Brush" Color="#6d86ff" />
    <SolidColorBrush x:Key="WarnBrush" Color="#e2b155" />
    <SolidColorBrush x:Key="AlertBrush" Color="#ee6079" />
    <SolidColorBrush x:Key="LineBrush" Color="#13FFFFFF" />
    <SolidColorBrush x:Key="Line2Brush" Color="#0DFFFFFF" />
    <SolidColorBrush x:Key="HiBrush" Color="#24FFFFFF" />
    <SolidColorBrush x:Key="FieldBrush" Color="#09FFFFFF" />
    <SolidColorBrush x:Key="FieldHoverBrush" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="PanelBrush" Color="#0CFFFFFF" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#24FFFFFF" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#2652d6bd" />
    <SolidColorBrush x:Key="AccentLineBrush" Color="#5252d6bd" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#52d6bd" />
    <SolidColorBrush x:Key="Accent2SoftBrush" Color="#2E6d86ff" />
    <SolidColorBrush x:Key="Accent2LineBrush" Color="#526d86ff" />
    <SolidColorBrush x:Key="Accent2TextBrush" Color="#6d86ff" />
    <SolidColorBrush x:Key="WarnSoftBrush" Color="#26e2b155" />
    <SolidColorBrush x:Key="WarnLineBrush" Color="#4De2b155" />
    <SolidColorBrush x:Key="AlertSoftBrush" Color="#26ee6079" />
    <SolidColorBrush x:Key="AlertLineBrush" Color="#52ee6079" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#4C52d6bd" />
    <SolidColorBrush x:Key="BarBrush" Color="#9452d6bd" />
    <SolidColorBrush x:Key="AmbientABrush" Color="Transparent" />
    <SolidColorBrush x:Key="AmbientBBrush" Color="Transparent" />
    <SolidColorBrush x:Key="BrandGradient" Color="#52d6bd" />
    <Color x:Key="AccentColor">#52d6bd</Color>
    <sys:Double x:Key="AmbientOpacity">0.42</sys:Double>

    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

    <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    <conv:NotEmptyToVisibilityConverter x:Key="NotEmptyToVis" />
    <conv:UpperCaseConverter x:Key="Upper" />

    <!-- ============================================================ icons (24×24 grid, from the page's SVGs) -->
    <Geometry x:Key="IcoPalette">M12 3 A9 9 0 1 0 12 21 C13 21 13.6 20.3 13.6 19.5 C13.6 19.1 13.4 18.7 13.1 18.4 C12.8 18.1 12.7 17.8 12.7 17.4 C12.7 16.6 13.4 16 14.2 16 L16 16 A5 5 0 0 0 21 11 C21 6.6 17 3 12 3 Z M8.6 11.5 A1.1 1.1 0 1 1 6.4 11.5 A1.1 1.1 0 1 1 8.6 11.5 Z M12.1 7.5 A1.1 1.1 0 1 1 9.9 7.5 A1.1 1.1 0 1 1 12.1 7.5 Z M17.1 9.5 A1.1 1.1 0 1 1 14.9 9.5 A1.1 1.1 0 1 1 17.1 9.5 Z</Geometry>
    <Geometry x:Key="IcoMoon">M20 14.5 A8.5 8.5 0 0 1 9.5 4 A8.5 8.5 0 1 0 20 14.5 Z</Geometry>
    <Geometry x:Key="IcoSun">M16.2 12 A4.2 4.2 0 1 1 7.8 12 A4.2 4.2 0 1 1 16.2 12 Z M12 2 L12 4.4 M12 19.6 L12 22 M2 12 L4.4 12 M19.6 12 L22 12 M4.9 4.9 L6.6 6.6 M17.4 17.4 L19.1 19.1 M19.1 4.9 L17.4 6.6 M6.6 17.4 L4.9 19.1</Geometry>
    <Geometry x:Key="IcoAutoRing">M20 12 A8 8 0 1 1 4 12 A8 8 0 1 1 20 12 Z</Geometry>
    <Geometry x:Key="IcoAutoHalf">M12 4 A8 8 0 0 0 12 20 Z</Geometry>
    <Geometry x:Key="IcoCopy">M9 9 L21 9 L21 21 L9 21 Z M5 15 L5 5 A2 2 0 0 1 7 3 L17 3</Geometry>
    <Geometry x:Key="IcoUp">M12 19 L12 5 M5 12 L12 5 L19 12</Geometry>
    <Geometry x:Key="IcoDown">M12 5 L12 19 M19 12 L12 19 L5 12</Geometry>
    <Geometry x:Key="IcoRefresh">M20 12 A8 8 0 1 1 17.66 6.34 M20 4 L20 9 L15 9</Geometry>
    <Geometry x:Key="IcoExit">M15 3 L19 3 A2 2 0 0 1 21 5 L21 19 A2 2 0 0 1 19 21 L15 21 M10 17 L15 12 L10 7 M15 12 L3 12</Geometry>
    <Geometry x:Key="IcoBolt">M13 2 L4 14 L11 14 L10 22 L19 10 L12 10 Z</Geometry>
    <Geometry x:Key="IcoPower">M12 3 L12 11 M6.3 6.8 A8 8 0 1 0 17.7 6.8</Geometry>
    <Geometry x:Key="IcoLog">M4 17 L10 11 L4 5 M12 19 L20 19</Geometry>
    <Geometry x:Key="IcoMin">M5 12 L19 12</Geometry>
    <Geometry x:Key="IcoMax">M5 5 L19 5 L19 19 L5 19 Z</Geometry>
    <Geometry x:Key="IcoRestore">M8 8 L19 8 L19 19 L8 19 Z M5 16 L5 5 L16 5</Geometry>
    <Geometry x:Key="IcoClose">M6 6 L18 18 M18 6 L6 18</Geometry>
    <Geometry x:Key="IcoArrowRight">M5 12 L19 12 M13 6 L19 12 L13 18</Geometry>
    <Geometry x:Key="IcoHelp">M21 12 A9 9 0 1 1 3 12 A9 9 0 1 1 21 12 Z M9.5 9.5 A2.5 2.5 0 1 1 13 11.8 C12.4 12.1 12 12.7 12 13.4 L12 14 M12 17.2 L12 17.3</Geometry>

    <!-- ============================================================ text -->
    <Style x:Key="SectionLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    </Style>
    <Style x:Key="Mono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    </Style>

    <!-- ============================================================ card (square, like the page) -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Section header: LABEL ───────── count -->
    <Style x:Key="SectionHead" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Margin" Value="0,0,0,10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource Upper}}"
                                   Style="{StaticResource SectionLabel}" VerticalAlignment="Center" />
                        <Rectangle Grid.Column="1" Height="1" Margin="9,0" VerticalAlignment="Center"
                                   Fill="{DynamicResource LineBrush}">
                            <Rectangle.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="Black" Offset="0" />
                                    <GradientStop Color="Transparent" Offset="1" />
                                </LinearGradientBrush>
                            </Rectangle.OpacityMask>
                        </Rectangle>
                        <ContentPresenter Grid.Column="2" Content="{TemplateBinding Tag}" VerticalAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ buttons -->
    <Style x:Key="Btn" TargetType="ButtonBase">
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="Background" Value="{DynamicResource FieldBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="13,0" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource FieldHoverBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource HiBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.96" ScaleY="0.96" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BtnSquare" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Width" Value="40" />
    </Style>

    <Style x:Key="BtnAccent" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentLineBrush}" />
    </Style>

    <Style x:Key="IconBtn" TargetType="ButtonBase" BasedOn="{StaticResource Btn}">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource Ink2Brush}" />
        <Setter Property="Margin" Value="7,0,0,0" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="WinBtn" TargetType="Button">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource FieldHoverBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WinCloseBtn" TargetType="Button" BasedOn="{StaticResource WinBtn}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#E5484D" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Plain text link (footer "Support") -->
    <Style x:Key="LinkBtn" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Ink2Brush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource LineBrush}"
                            Background="Transparent" Padding="0,0,0,1">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ tags / chips -->
    <Style x:Key="Tag" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource FieldHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Ink2Brush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="5,2" />
        <Setter Property="Margin" Value="0,0,3,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextElement.FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="TextElement.FontSize" Value="8.5" />
        <Setter Property="TextElement.FontWeight" Value="Bold" />
    </Style>
    <Style x:Key="TagProto" TargetType="Border" BasedOn="{StaticResource Tag}">
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentLineBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentTextBrush}" />
    </Style>
    <Style x:Key="TagSec" TargetType="Border" BasedOn="{StaticResource Tag}">
        <Setter Property="Background" Value="{DynamicResource Accent2SoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Accent2LineBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Accent2TextBrush}" />
    </Style>
    <Style x:Key="TagWarn" TargetType="Border" BasedOn="{StaticResource Tag}">
        <Setter Property="Background" Value="{DynamicResource WarnSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WarnLineBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource WarnBrush}" />
    </Style>

    <!-- ============================================================ text box -->
    <Style x:Key="Input" TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Background" Value="{DynamicResource FieldBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="MinHeight" Value="42" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}"
                                       Foreground="{DynamicResource MutedBrush}" Margin="12,0"
                                       VerticalAlignment="Center" IsHitTestVisible="False"
                                       TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource HiBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ scrollbar -->
    <Style x:Key="ThumbStyle" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="{DynamicResource ScrollThumbBrush}" Margin="2,0" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="8" />
        <Setter Property="MinWidth" Value="8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ThumbStyle}" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Height" Value="0" />
                <Setter Property="MinHeight" Value="0" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource BgBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Padding" Value="8,5" />
    </Style>

    <!-- ============================================================ configuration list -->
    <Style x:Key="CfgList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    </Style>

    <Style x:Key="CfgItem" TargetType="ListBoxItem">
        <Setter Property="Margin" Value="0,0,2,5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="{DynamicResource FieldBrush}"
                            BorderBrush="{DynamicResource Line2Brush}" BorderThickness="1"
                            Padding="11,8,8,8" SnapsToDevicePixels="True">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource FieldHoverBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource HiBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
