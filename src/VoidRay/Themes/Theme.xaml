    <Geometry x:Key="IcoCheck">M5 12.5 L10 17.5 L19 7</Geometry>
    <Geometry x:Key="IcoChevron">M9 6 L15 12 L9 18</Geometry>
    <Geometry x:Key="IcoPaste">M9 4 L15 4 L15 7 L9 7 Z M15 5 L18 5 A1 1 0 0 1 19 6 L19 20 A1 1 0 0 1 18 21 L6 21 A1 1 0 0 1 5 20 L5 6 A1 1 0 0 1 6 5 L9 5</Geometry>

    <!-- ============================================================ text -->
    <Style x:Key="SectionLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    </Style>
    <Style x:Key="Mono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        <Setter Property="Margin" Value="4,0,0,8" />
    </Style>

    <!-- ============================================================ surfaces -->
    <!-- Frosted glass panel -->
    <Style x:Key="Glass" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource GlassBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GlassLineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="28" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>
    <!-- Flat rounded tile inside a panel -->
    <Style x:Key="Tile" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Padding" Value="16,13" />
    </Style>
    <!-- Kept for older markup -->
    <Style x:Key="Card" TargetType="Border" BasedOn="{StaticResource Glass}" />

    <Style x:Key="SectionHead" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Margin" Value="4,0,0,10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <DockPanel>
                        <ContentPresenter DockPanel.Dock="Right" Content="{TemplateBinding Tag}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" />
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ buttons -->
    <Style x:Key="Btn" TargetType="ButtonBase">
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="MinHeight" Value="42" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="21" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.86" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.96" ScaleY="0.96" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Primary: solid ink pill -->
    <Style x:Key="BtnSolid" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Background" Value="{DynamicResource SolidBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OnSolidBrush}" />
        <Setter Property="MinHeight" Value="56" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Padding" Value="24,0" />
    </Style>

    <Style x:Key="BtnAccent" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    </Style>

    <Style x:Key="BtnSquare" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Width" Value="42" />
    </Style>

    <!-- Round icon button -->
    <Style x:Key="IconBtn" TargetType="ButtonBase" BasedOn="{StaticResource Btn}">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource Ink2Brush}" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Big round solid button (settings next to the slider) -->
    <Style x:Key="RoundSolid" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Width" Value="64" />
        <Setter Property="Height" Value="64" />
        <Setter Property="MinHeight" Value="64" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="{DynamicResource SolidBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OnSolidBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Ellipse x:Name="Bd" Fill="{TemplateBinding Background}">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="22" ShadowDepth="6" Direction="270" Opacity="0.28" />
                            </Ellipse.Effect>
                        </Ellipse>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.88" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.94" ScaleY="0.94" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Segment of a segmented control: Tag = true when selected -->
    <Style x:Key="SegBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Ink2Brush}" />
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                <Setter Property="Background" Value="{DynamicResource SolidBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource OnSolidBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="SegTrack" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="CornerRadius" Value="23" />
        <Setter Property="Padding" Value="4" />
    </Style>

    <Style x:Key="WinBtn" TargetType="Button">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Margin" Value="2,0,0,0" />
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="10">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WinCloseBtn" TargetType="Button" BasedOn="{StaticResource WinBtn}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="10">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#E5484D" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Plain text link -->
    <Style x:Key="LinkBtn" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Ink2Brush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Invisible full-size button (scrim, clickable cards) -->
    <Style x:Key="Bare" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ tags / chips -->
    <Style x:Key="Tag" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Ink2Brush}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextElement.FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="TextElement.FontSize" Value="9" />
        <Setter Property="TextElement.FontWeight" Value="Bold" />
    </Style>
    <Style x:Key="TagProto" TargetType="Border" BasedOn="{StaticResource Tag}">
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentTextBrush}" />
    </Style>
    <Style x:Key="TagSec" TargetType="Border" BasedOn="{StaticResource Tag}">
        <Setter Property="Background" Value="{DynamicResource Accent2SoftBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Accent2TextBrush}" />
    </Style>
    <Style x:Key="TagWarn" TargetType="Border" BasedOn="{StaticResource Tag}">
        <Setter Property="Background" Value="{DynamicResource WarnSoftBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource WarnBrush}" />
    </Style>

    <!-- ============================================================ text box -->
    <Style x:Key="Input" TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="MinHeight" Value="56" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="18"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}"
                                       Foreground="{DynamicResource MutedBrush}" Margin="18,0"
                                       VerticalAlignment="Center" IsHitTestVisible="False"
                                       TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ scrollbar -->
    <Style x:Key="ThumbStyle" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="{DynamicResource ScrollThumbBrush}" CornerRadius="3" Margin="2,0" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="8" />
        <Setter Property="MinWidth" Value="8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ThumbStyle}" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Height" Value="0" />
                <Setter Property="MinHeight" Value="0" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource SolidBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OnSolidBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ server list -->
    <Style x:Key="CfgList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    </Style>

    <Style x:Key="CfgItem" TargetType="ListBoxItem">
        <Setter Property="Margin" Value="0,0,4,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="{DynamicResource SurfaceBrush}" CornerRadius="18"
                            BorderBrush="Transparent" BorderThickness="1.5"
                            Padding="16,12,10,12" SnapsToDevicePixels="True">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ slide to connect -->
    <Style TargetType="ctl:SlideToConnect">
        <Setter Property="Height" Value="64" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ctl:SlideToConnect">
                    <Grid>
                        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="32" />
                        <Border x:Name="PART_Fill" HorizontalAlignment="Left" CornerRadius="32" Width="64"
                                Background="{DynamicResource AccentSoftBrush}" />
                        <TextBlock x:Name="PART_Label" Text="{TemplateBinding Label}" FontSize="15" FontWeight="Medium"
                                   Foreground="{DynamicResource InkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Margin="56,0,0,0" IsHitTestVisible="False" />
                        <Grid x:Name="PART_Knob" Width="64" Height="64" HorizontalAlignment="Left" Background="Transparent">
                            <Ellipse Fill="{DynamicResource SolidBrush}">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.30" />
                                </Ellipse.Effect>
                            </Ellipse>
                            <ctl:Icon x:Name="ArrowOn" Data="{StaticResource IcoArrowRight}" Size="24" StrokeThickness="2.1"
                                      Foreground="{DynamicResource OnSolidBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <ctl:Icon x:Name="ArrowOff" Data="{StaticResource IcoArrowLeft}" Size="24" StrokeThickness="2.1"
                                      Foreground="{DynamicResource OnSolidBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Visibility="Collapsed" />
                            <Ellipse x:Name="Spinner" Width="24" Height="24" Stroke="{DynamicResource OnSolidBrush}" StrokeThickness="2.5"
                                     StrokeDashArray="6 3" StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5" Visibility="Collapsed">
                                <Ellipse.RenderTransform>
                                    <RotateTransform />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsOn" Value="True">
                            <Setter TargetName="ArrowOn" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="ArrowOff" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PART_Fill" Property="Background" Value="{DynamicResource AccentLineBrush}" />
                            <Setter TargetName="PART_Label" Property="Margin" Value="0,0,56,0" />
                        </Trigger>
                        <Trigger Property="IsBusy" Value="True">
                            <Setter TargetName="ArrowOn" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="ArrowOff" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Spinner" Property="Visibility" Value="Visible" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="Spin">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Spinner" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                         From="0" To="360" Duration="0:0:0.9" RepeatBehavior="Forever" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="Spin" />
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="PART_Label" Property="TextDecorations" Value="Underline" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ the orb -->
    <!-- ContentControl with Tag = connection state. Drawn on a 320×320 grid. -->
    <ControlTemplate x:Key="OrbTemplate" TargetType="ContentControl">
        <Grid x:Name="OrbRoot" Width="320" Height="320" RenderTransformOrigin="0.5,0.5">
            <Grid.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="DriftHost" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                             From="0" To="360" Duration="0:0:26" RepeatBehavior="Forever" />
                            <DoubleAnimation Storyboard.TargetName="CounterHost" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                             From="360" To="0" Duration="0:0:17" RepeatBehavior="Forever" />
                            <DoubleAnimation Storyboard.TargetName="OrbRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                             From="1" To="1.025" Duration="0:0:3" AutoReverse="True" RepeatBehavior="Forever">
                                <DoubleAnimation.EasingFunction>
                                    <SineEase EasingMode="EaseInOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="OrbRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                             From="1" To="1.025" Duration="0:0:3" AutoReverse="True" RepeatBehavior="Forever">
                                <DoubleAnimation.EasingFunction>
                                    <SineEase EasingMode="EaseInOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Grid.Triggers>
            <Grid.RenderTransform>
                <ScaleTransform />
            </Grid.RenderTransform>

            <Ellipse x:Name="Halo" Margin="-110" Fill="{DynamicResource HaloBrush}" Opacity="0" IsHitTestVisible="False" />

            <Ellipse x:Name="Ring" Margin="-16" Stroke="{DynamicResource AccentBrush}" StrokeThickness="3"
                     StrokeDashArray="14 60" StrokeDashCap="Round" Opacity="0" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <RotateTransform />
                </Ellipse.RenderTransform>
            </Ellipse>

            <Grid x:Name="Sphere">
                <Grid.Clip>
                    <EllipseGeometry Center="160,160" RadiusX="160" RadiusY="160" />
                </Grid.Clip>
                <Rectangle Fill="{DynamicResource OrbBaseBrush}" />
                <Grid x:Name="BoostHost" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <RotateTransform />
                    </Grid.RenderTransform>
                <Grid x:Name="DriftHost" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <RotateTransform />
                    </Grid.RenderTransform>
                    <Ellipse Width="300" Height="300" Margin="-90,0,0,-110" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                             Fill="{DynamicResource OrbBlobABrush}" />
                    <Ellipse Width="300" Height="300" Margin="0,-110,-90,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                             Fill="{DynamicResource OrbBlobBBrush}" />
                    <Ellipse Width="240" Height="240" Margin="0,0,-70,-50" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                             Fill="{DynamicResource OrbBlobCBrush}" />
                    <Ellipse Width="220" Height="220" Margin="-60,-40,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                             Fill="{DynamicResource OrbBlobDBrush}" />
                </Grid>
                </Grid>
                <Grid x:Name="CounterHost" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <RotateTransform />
                    </Grid.RenderTransform>
                    <Ellipse Width="200" Height="200" Margin="0,0,-30,40" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                             Fill="{DynamicResource OrbBlobABrush}" Opacity="0.7" />
                </Grid>
                <Ellipse x:Name="Veil" Fill="{DynamicResource VeilBrush}" Opacity="0.5" />
                <Ellipse Margin="40,-60,40,120">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#55FFFFFF" Offset="0" />
                            <GradientStop Color="#00FFFFFF" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
            </Grid>
        </Grid>
        <ControlTemplate.Triggers>

            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="Connected">
                <DataTrigger.EnterActions>
                    <BeginStoryboard x:Name="On">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Veil" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.9" />
                            <DoubleAnimation Storyboard.TargetName="Halo" Storyboard.TargetProperty="Opacity"
                                             From="0.65" To="1" Duration="0:0:2.2" AutoReverse="True" RepeatBehavior="Forever" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <StopStoryboard BeginStoryboardName="On" />
                </DataTrigger.ExitActions>
            </DataTrigger>

            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="Connecting">
                <DataTrigger.EnterActions>
                    <BeginStoryboard x:Name="Busy">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Veil" Storyboard.TargetProperty="Opacity" To="0.2" Duration="0:0:0.6" />
                            <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.3" />
                            <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                             From="0" To="360" Duration="0:0:1.1" RepeatBehavior="Forever" />
                            <DoubleAnimation Storyboard.TargetName="BoostHost" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                             From="0" To="360" Duration="0:0:2.4" RepeatBehavior="Forever" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <StopStoryboard BeginStoryboardName="Busy" />
                </DataTrigger.ExitActions>
            </DataTrigger>

            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="Disconnecting">
                <DataTrigger.EnterActions>
                    <BeginStoryboard x:Name="Leaving">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.3" />
                            <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                             From="360" To="0" Duration="0:0:1.1" RepeatBehavior="Forever" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <StopStoryboard BeginStoryboardName="Leaving" />
                </DataTrigger.ExitActions>
            </DataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
</ResourceDictionary>
