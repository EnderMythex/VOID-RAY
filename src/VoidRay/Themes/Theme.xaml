<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:conv="clr-namespace:VoidRay.Converters"
                    xmlns:ctl="clr-namespace:VoidRay.Controls">

    <!-- Brushes are (re)defined at runtime by ThemeManager; these are only design-time defaults. -->
    <SolidColorBrush x:Key="BgBrush" Color="#07090e" />
    <SolidColorBrush x:Key="InkBrush" Color="#e8ecf4" />
    <SolidColorBrush x:Key="Ink2Brush" Color="#aab3c6" />
    <SolidColorBrush x:Key="MutedBrush" Color="#737e96" />
    <SolidColorBrush x:Key="AccentBrush" Color="#52d6bd" />
    <SolidColorBrush x:Key="Accent2Brush" Color="#6d86ff" />
    <SolidColorBrush x:Key="WarnBrush" Color="#e2b155" />
    <SolidColorBrush x:Key="AlertBrush" Color="#ee6079" />
    <SolidColorBrush x:Key="LineBrush" Color="#13FFFFFF" />
    <SolidColorBrush x:Key="Line2Brush" Color="#0DFFFFFF" />
    <SolidColorBrush x:Key="HiBrush" Color="#24FFFFFF" />
    <SolidColorBrush x:Key="FieldBrush" Color="#09FFFFFF" />
    <SolidColorBrush x:Key="FieldHoverBrush" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="PanelBrush" Color="#0CFFFFFF" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#24FFFFFF" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#2652d6bd" />
    <SolidColorBrush x:Key="AccentLineBrush" Color="#5252d6bd" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#52d6bd" />
    <SolidColorBrush x:Key="Accent2SoftBrush" Color="#2E6d86ff" />
    <SolidColorBrush x:Key="Accent2LineBrush" Color="#526d86ff" />
    <SolidColorBrush x:Key="Accent2TextBrush" Color="#6d86ff" />
    <SolidColorBrush x:Key="WarnSoftBrush" Color="#26e2b155" />
    <SolidColorBrush x:Key="WarnLineBrush" Color="#4De2b155" />
    <SolidColorBrush x:Key="AlertSoftBrush" Color="#26ee6079" />
    <SolidColorBrush x:Key="AlertLineBrush" Color="#52ee6079" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#4C52d6bd" />
    <SolidColorBrush x:Key="BarBrush" Color="#9452d6bd" />
    <SolidColorBrush x:Key="AmbientABrush" Color="Transparent" />
    <SolidColorBrush x:Key="AmbientBBrush" Color="Transparent" />
    <SolidColorBrush x:Key="BrandGradient" Color="#52d6bd" />
    <Color x:Key="AccentColor">#52d6bd</Color>
    <sys:Double x:Key="AmbientOpacity">0.42</sys:Double>

    <!-- New surfaces (glass layout); also redefined at runtime by ThemeManager. -->
    <SolidColorBrush x:Key="SurfaceBrush" Color="#0DFFFFFF" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#16FFFFFF" />
    <SolidColorBrush x:Key="GlassBrush" Color="#10FFFFFF" />
    <SolidColorBrush x:Key="GlassLineBrush" Color="#17FFFFFF" />
    <SolidColorBrush x:Key="GlassHiBrush" Color="#29FFFFFF" />
    <SolidColorBrush x:Key="SolidBrush" Color="#f2f4f8" />
    <SolidColorBrush x:Key="OnSolidBrush" Color="#0b0d12" />
    <SolidColorBrush x:Key="DrawerBrush" Color="#0c0e14" />
    <SolidColorBrush x:Key="ScrimBrush" Color="#73000000" />
    <SolidColorBrush x:Key="VeilBrush" Color="#232835" />
    <SolidColorBrush x:Key="AuroraABrush" Color="Transparent" />
    <SolidColorBrush x:Key="AuroraBBrush" Color="Transparent" />
    <SolidColorBrush x:Key="AuroraCBrush" Color="Transparent" />
    <SolidColorBrush x:Key="OrbBaseBrush" Color="#8fa3ff" />
    <SolidColorBrush x:Key="OrbBlobABrush" Color="Transparent" />
    <SolidColorBrush x:Key="OrbBlobBBrush" Color="Transparent" />
    <SolidColorBrush x:Key="OrbBlobCBrush" Color="Transparent" />
    <SolidColorBrush x:Key="OrbBlobDBrush" Color="Transparent" />
    <SolidColorBrush x:Key="HaloBrush" Color="Transparent" />
    <sys:Double x:Key="AuroraOpacity">0.75</sys:Double>

    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

    <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    <conv:NotEmptyToVisibilityConverter x:Key="NotEmptyToVis" />
    <conv:UpperCaseConverter x:Key="Upper" />
    <conv:EqualsConverter x:Key="Eq" />

